rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Who may use the tool. Replace the placeholder with your team's Google emails.
    // Until you do, nobody can read or write (safe by default).
    function isTeamMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['you@example.com'];
    }

    // bugs/{bugId}/{fileName}: pictures up to 10 MB, videos up to 100 MB.
    match /bugs/{bugId}/{fileName} {
      allow read: if isTeamMember();
      allow write: if isTeamMember()
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
         || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024));
      allow delete: if isTeamMember();
    }
  }
}
